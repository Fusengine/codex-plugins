+    .note-marker { display: grid; place-items: center; width: 24px; height: 24px; color: var(--accent); }
+    .note-marker .icon { width: 15px; height: 15px; }
+    .composer { margin: 0 15px 15px; padding: 4px 10px 9px; background: var(--card); border: 1px solid var(--edge); border-radius: 11px; }
+    .composer-modes { display: flex; gap: 3px; border-bottom: 1px solid var(--line); }
+    .mode { min-height: 44px; padding: 0 8px; color: var(--muted); white-space: nowrap; }
+    .mode[aria-pressed="true"] { color: var(--accent); box-shadow: inset 0 -2px var(--accent); border-radius: 5px 5px 0 0; }
+    .composer textarea { display: block; width: 100%; min-height: 48px; resize: vertical; padding: 9px 5px; border: 0; background: transparent; font-size: .8125rem; }
+    .composer-footer { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding-left: 5px; }
+    .mobile-back { display: none; }
+
+    @media (max-width: 1120px) {
+      .shell { grid-template-columns: 72px minmax(0, 1fr); }
+      .rail { padding: 27px 12px 20px; }
+      .nav-brand { margin: 0 3px 37px; }
+      .rail .rail-text, .nav-count, .nav-label { display: none; }
+      .nav-link, .theme-toggle { justify-content: center; padding: 0; }
+      .profile { justify-content: center; padding-inline: 0; }
+    }
+    @media (max-width: 840px) {
+      .workspace { padding-inline: 24px; }
+      .desk { grid-template-columns: minmax(230px, .85fr) minmax(0, 1.15fr); gap: 14px; }
+      .overview-grid { gap: 14px; }
+      .routing { padding: 24px; gap: 18px; }
+      .letterhead { grid-template-columns: 1fr; padding: 17px; }
+      .letterhead .control { justify-self: start; }
+      .conversation-context { padding-inline: 17px; }
+      .conversation-body { padding-inline: 14px; }
+    }
+    @media (max-width: 700px) {
+      .shell { display: block; }
+      .workspace { padding: 24px 16px 34px; }
+      .screen-heading { align-items: start; flex-wrap: wrap; gap: 12px; margin-bottom: 21px; }
+      .heading-copy { flex: 1 1 100%; }
+      .heading-title { display: flex; align-items: center; gap: 9px; }
+      h1 { font-size: clamp(1.65rem, 6.8vw, 2.25rem); }
+      .heading-copy p { margin-top: 7px; }
+      .nav-toggle, .nav-close { display: inline-flex !important; }
+      .rail { display: none; position: fixed; inset: 0 auto 0 0; width: min(275px, 90vw); padding: 25px 15px 18px; height: 100dvh; overflow-y: auto; }
+      .shell[data-nav-open] .rail { display: flex; }
+      .shell[data-nav-open] .nav-scrim { display: block !important; position: fixed; z-index: 3; inset: 0; background: oklch(12% 0.027 273 / .64); }
+      .rail .rail-text, .nav-count, .nav-label { display: revert; }
+      .nav-brand { margin: 0 50px 33px 2px; }
+      .nav-close { position: absolute; top: 22px; right: 12px; }
+      .nav-link, .theme-toggle { justify-content: start; padding: 0 10px; }
+      .profile { justify-content: start; }
+      .desk, .overview-grid { grid-template-columns: 1fr; gap: 16px; }
+      .routing { grid-template-columns: 1fr; min-height: 0; gap: 18px; padding: 18px; }
+      .routing-copy h2 { margin-top: 9px; }
+      .routing-copy p { max-width: none; }
+      .readout { min-height: 134px; padding: 11px 12px; gap: 7px; }
+      .readout .icon { width: 1rem; height: 1rem; }
+      .overview-grid { margin-top: 23px; }
+      .letterhead { grid-template-columns: minmax(0, 1fr) auto; }
+      .letterhead .control { justify-self: end; }
+      .thread { max-height: 410px; }
+      .mobile-back { display: inline-flex; margin: -8px 0 5px; }
+      .overview-shortcut { margin-left: 53px; }
+    }
+    @media (max-width: 360px) {
+      .workspace { padding-inline: 12px; }
+      .letterhead { grid-template-columns: 1fr; }
+      .letterhead .control { justify-self: start; }
+    }
+    @media (prefers-reduced-motion: reduce) {
+      *, *::before, *::after { scroll-behavior: auto !important; }
+    }
+  </style>
+</head>
+<body>
+  <!-- Icon paths from the project's installed Lucide package (ISC). -->
