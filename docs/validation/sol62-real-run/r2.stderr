+    <symbol id="i-dashboard" viewBox="0 0 24 24"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></symbol>
+    <symbol id="i-inbox" viewBox="0 0 24 24"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></symbol>
+    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-15.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></symbol>
+    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></symbol>
+    <symbol id="i-up" viewBox="0 0 24 24"><path d="M7 7h10v10M7 17 17 7"/></symbol>
+    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-7-7 7 7-7 7"/></symbol>
+    <symbol id="i-search" viewBox="0 0 24 24"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></symbol>
+    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
+    <symbol id="i-send" viewBox="0 0 24 24"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11zM21.854 2.147l-10.94 10.939"/></symbol>
+    <symbol id="i-lock" viewBox="0 0 24 24"><circle cx="12" cy="16" r="1"/><rect x="3" y="10" width="18" height="12" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></symbol>
+    <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16 9-5.5 5.5L8 12"/></symbol>
+    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 5h16M4 12h16M4 19h16"/></symbol>
+    <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18m0-12 12 12"/></symbol>
+    <symbol id="i-users" viewBox="0 0 24 24"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0 .45-8.3"/></symbol>
+    <symbol id="i-back" viewBox="0 0 24 24"><path d="m12 19-7-7 7-7m7 7H5"/></symbol>
+  </svg>
+  <a class="skip control secondary" href="#content">Aller au contenu</a>
+  <div class="shell">
+    <div class="nav-scrim" aria-hidden="true"></div>
+    <aside id="navigation" class="rail" aria-label="Espace support">
+      <div class="nav-brand">
+        <div class="mark"><svg class="icon" aria-hidden="true"><use href="#i-headset"/></svg></div>
+        <div class="rail-text"><strong>Fusengine</strong><small>Espace support</small></div>
+      </div>
+      <button type="button" class="nav-close control secondary icon-control" aria-label="Fermer la navigation">
+        <svg class="icon" aria-hidden="true"><use href="#i-x"/></svg>
+      </button>
+      <nav aria-label="Navigation principale">
+        <p class="nav-label meta small">Espace de travail</p>
+        <a class="nav-link" data-route="overview" href="#overview-light" title="Vue d’ensemble" aria-label="Vue d’ensemble">
+          <svg class="icon" aria-hidden="true"><use href="#i-dashboard"/></svg><span class="rail-text">Vue d’ensemble</span>
+        </a>
+        <a class="nav-link" data-route="inbox" href="#inbox-light" title="Boîte de réception" aria-label="Boîte de réception" aria-current="page">
+          <svg class="icon" aria-hidden="true"><use href="#i-inbox"/></svg><span class="rail-text">Boîte de réception</span><span class="nav-count" id="nav-count" aria-hidden="true">4</span>
+        </a>
+      </nav>
+      <div class="rail-footer">
+        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Activer le thème sombre" title="Activer le thème sombre" aria-pressed="false">
+          <svg class="icon theme-light" aria-hidden="true"><use href="#i-sun"/></svg>
+          <svg class="icon theme-dark" aria-hidden="true"><use href="#i-moon"/></svg>
+          <span class="rail-text">Apparence</span><span class="rail-text theme-name" id="theme-name">Clair</span>
+        </button>
+        <div class="profile">
+          <span class="avatar staff" aria-hidden="true">SL</span>
+          <div class="rail-text"><strong>Sophie Laurent</strong><small class="meta">Maquette interactive</small></div>
+        </div>
+      </div>
+    </aside>
+
+    <main id="content" tabindex="-1">
+      <div class="workspace">
+        <section id="inbox" aria-labelledby="inbox-title">
+          <header class="screen-heading">
+            <div class="heading-copy">
+              <div class="heading-title">
+                <button type="button" class="nav-toggle control secondary icon-control" aria-label="Ouvrir la navigation" aria-controls="navigation" aria-expanded="false">
+                  <svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg>
+                </button>
+                <h1 id="inbox-title" tabindex="-1">Boîte de réception</h1>
+              </div>
+              <p class="muted" id="inbox-summary">4 demandes ouvertes</p>
+            </div>
+          </header>
+          <noscript><p>Demandes ouvertes : Accès à mon espace, Mise à jour de facturation, Accès à un outil interne et Invitation de mon équipe. Activez JavaScript pour ouvrir une demande ou changer d’affichage.</p></noscript>
+          <div class="desk" id="desk" hidden>
+            <section class="surface queue" aria-labelledby="queue-title">
+              <div class="queue-top">
+                <h2 id="queue-title" tabindex="-1">Demandes</h2>
+                <div class="filters" aria-label="Filtrer les demandes" role="group">
+                  <button type="button" class="filter" data-filter="open" aria-pressed="true">Ouvertes <span id="filter-open" class="numeric">4</span></button>
+                  <button type="button" class="filter" data-filter="resolved" aria-pressed="false">Résolues <span id="filter-resolved" class="numeric">2</span></button>
+                  <button type="button" class="filter" data-filter="all" aria-pressed="false">Toutes</button>
+                </div>
+                <label class="search">
+                  <svg class="icon" aria-hidden="true"><use href="#i-search"/></svg>
+                  <span class="sr-only">Rechercher une demande</span>
+                  <input type="search" id="search" placeholder="Rechercher une demande" autocomplete="off">
+                </label>
+              </div>
+              <ul class="queue-list list" id="queue-list" aria-label="Résultats"></ul>
+              <p id="queue-empty" class="empty" hidden></p>
+            </section>
+            <div id="reading">
+              <button type="button" class="control text-control mobile-back" id="back-queue">
+                <svg class="icon" aria-hidden="true"><use href="#i-back"/></svg> Retour aux demandes
+              </button>
+              <article class="surface folio" id="folio" aria-labelledby="case-title">
+                <header class="register letterhead">
+                  <div>
+                    <span class="status small" id="case-status"></span>
+                    <h2 id="case-title" tabindex="-1"></h2>
+                    <p class="meta" id="case-contact"></p>
+                  </div>
+                  <button type="button" class="control on-register" id="case-action"></button>
+                </header>
+                <p class="conversation-context">
+                  <svg class="icon" aria-hidden="true"><use href="#i-users"/></svg>
+                  Responsable <strong id="case-owner"></strong>
+                </p>
+                <div class="conversation-body">
+                  <h3>Conversation</h3>
+                  <ol class="thread list" id="thread" aria-label="Messages"></ol>
+                </div>
+                <form class="composer" id="composer">
+                  <div class="composer-modes" role="group" aria-label="Type de message">
+                    <button type="button" class="control mode" data-mode="reply" aria-pressed="true">Réponse</button>
+                    <button type="button" class="control mode" data-mode="note" aria-pressed="false">
+                      <svg class="icon" aria-hidden="true"><use href="#i-lock"/></svg> Note interne
+                    </button>
+                  </div>
+                  <label for="message" class="sr-only" id="message-label">Écrire une réponse</label>
+                  <textarea id="message" rows="2" placeholder="Écrire une réponse…" required></textarea>
+                  <div class="composer-footer">
+                    <span class="meta" id="composer-audience">Visible par le demandeur</span>
+                    <button type="submit" id="send-message" class="control action">
+                      Envoyer <svg class="icon" aria-hidden="true"><use href="#i-send"/></svg>
+                    </button>
+                  </div>
+                </form>
+              </article>
+            </div>
+          </div>
+        </section>
+
+        <section id="overview" aria-labelledby="overview-title" hidden>
+          <header class="screen-heading">
+            <div class="heading-copy">
+              <div class="heading-title">
+                <button type="button" class="nav-toggle control secondary icon-control" aria-label="Ouvrir la navigation" aria-controls="navigation" aria-expanded="false">
+                  <svg class="icon" aria-hidden="true"><use href="#i-menu"/></svg>
+                </button>
+                <h1 id="overview-title" tabindex="-1">Vue d’ensemble</h1>
+              </div>
+              <p class="muted">Suivi des demandes de l’équipe support</p>
+            </div>
+            <a class="control secondary overview-shortcut" data-route="inbox" href="#inbox-light">
+              Ouvrir la boîte <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg>
+            </a>
+          </header>
+          <section class="register routing" aria-labelledby="routing-title">
+            <div class="routing-copy">
+              <span class="register-symbol"><svg class="icon" aria-hidden="true"><use href="#i-inbox"/></svg></span>
+              <h2 id="routing-title">Charge de support</h2>
+              <p id="routing-summary">6 demandes réparties entre 2 responsables.</p>
+            </div>
+            <div class="readouts">
+              <a class="readout" data-route="inbox" data-open-filter="open" href="#inbox-light">
+                <span class="readout-top"><svg class="icon" aria-hidden="true"><use href="#i-inbox"/></svg><svg class="icon" aria-hidden="true"><use href="#i-up"/></svg></span>
+                <span><strong class="metric-value numeric" id="metric-open">4</strong><span class="readout-label"> ouvertes</span></span>
+              </a>
+              <a class="readout" data-route="inbox" data-open-filter="resolved" href="#inbox-light">
+                <span class="readout-top"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg><svg class="icon" aria-hidden="true"><use href="#i-up"/></svg></span>
+                <span><strong class="metric-value numeric" id="metric-resolved">2</strong><span class="readout-label"> résolues</span></span>
+              </a>
+            </div>
+          </section>
+          <div class="overview-grid">
+            <section class="surface" aria-labelledby="to-do-title">
+              <header class="panel-header">
+                <h2 id="to-do-title">À traiter</h2>
+                <a class="control text-control" data-route="inbox" data-open-filter="open" href="#inbox-light">Voir la file <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
+              </header>
+              <ul class="overview-list list" id="open-requests"></ul>
+            </section>
+            <div class="side-stack">
+              <section class="surface" aria-labelledby="owners-title">
+                <header class="panel-header"><h2 id="owners-title">Par responsable</h2></header>
+                <ul class="owners list" id="owners"></ul>
+              </section>
+              <section class="surface closed" aria-labelledby="recent-title">
+                <header class="panel-header"><h2 id="recent-title">Résolues</h2></header>
+                <ul class="overview-list list" id="closed-requests"></ul>
+              </section>
+            </div>
+          </div>
+        </section>
+        <p class="sr-only" id="announcement" role="status"></p>
+      </div>
+    </main>
+  </div>
+
+  <script>
+    // Local fixture: docs/concept-support/index.html. Nothing leaves this tab.
+    const sophie = 'Sophie Laurent';
+    const thomas = 'Thomas Bernard';
+    const records = [
+      {
+        id: 'access', subject: 'Accès à mon espace', name: 'Camille Martin', organization: 'Atelier Studio', owner: sophie,
+        preview: 'Le message indique que mon accès a expiré.',
+        thread: [
+          { author: 'Camille Martin', at: '10:24', body: 'Bonjour, je n’arrive plus à accéder à mon espace depuis ce matin. Pourriez-vous m’aider ?' },
+          { author: sophie, at: '10:31', body: 'Bonjour Camille, bien sûr ! Pouvez-vous me préciser le message qui s’affiche lorsque vous essayez de vous connecter ?' },
+          { author: sophie, at: '10:36', body: 'Vérifier le renouvellement de l’accès avant de répondre.', note: true },
+          { author: 'Camille Martin', at: '10:42', body: 'Merci ! Le message indique que mon accès a expiré.' }
+        ]
+      },
+      { id: 'billing', subject: 'Mise à jour de facturation', name: 'Léa Morel', organization: 'Maison Alba', owner: sophie, preview: 'Est-ce possible de modifier nos informations ?', at: '09:18' },
+      { id: 'internal', subject: 'Accès à un outil interne', name: 'Léa Morel', organization: 'Équipe interne', owner: thomas, preview: 'Puis-je obtenir l’accès pour mon nouveau projet ?' },
+      { id: 'invite', subject: 'Invitation de mon équipe', name: 'Hugo Perrin', organization: 'Studio Horizon', owner: sophie, preview: 'Je souhaite inviter deux collègues.' },
+      { id: 'widget', subject: 'Question sur le widget', name: 'Noah Petit', organization: 'Collectif Nord', owner: sophie, preview: 'Question sur son installation', resolved: true },
+      { id: 'subscription', subject: 'Modification de mon abonnement', name: 'Sarah Dubois', organization: 'Maison Rivage', preview: 'Merci pour votre aide !', resolved: true }
+    ].map(record => ({
+      ...record,
+      thread: record.thread ?? [{ author: record.name, at: record.at, body: record.preview }]
+    }));
+
+    const get = id => document.getElementById(id);
+    const root = document.documentElement;
+    const shell = document.querySelector('.shell');
+    const mobile = matchMedia('(max-width: 700px)');
+    const preference = matchMedia('(prefers-color-scheme: dark)');
+    const filters = [...document.querySelectorAll('[data-filter]')];
+    const modes = [...document.querySelectorAll('[data-mode]')];
+    const routes = [...document.querySelectorAll('[data-route]')];
+    const drafts = new Map();
+    const names = { inbox: 'Boîte de réception', overview: 'Vue d’ensemble' };
+    const state = { screen: '', theme: '', filter: 'open', query: '', selected: 'access', mode: 'reply' };
+    let navTrigger;
+
+    const initials = name => name.split(' ').slice(0, 2).map(word => word[0]).join('');
+    const normalize = value => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase('fr');
+    const svg = name => '<svg class="icon" aria-hidden="true"><use href="#i-' + name + '"/></svg>';
+    const plain = value => String(value).replace(/[&<>"]/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[character]));
+    const setText = (id, value) => { get(id).textContent = value; };
+    const announce = value => setText('announcement', value);
+    const avatar = (name, staff = false) => '<span class="avatar' + (staff ? ' staff' : '') + '" aria-hidden="true">' + plain(initials(name)) + '</span>';
+    const openCount = value => value + (value === 1 ? ' demande ouverte' : ' demandes ouvertes');
+
+    function visibleRecords() {
+      const query = normalize(state.query.trim());
+      return records.filter(record => {
+        const status = record.resolved ? 'resolved' : 'open';
+        const fields = [record.subject, record.name, record.organization, record.preview, record.owner ?? ''];
+        return (state.filter === 'all' || status === state.filter) && normalize(fields.join(' ')).includes(query);
+      });
+    }
+
+    function renderCounts() {
+      const open = records.filter(record => !record.resolved).length;
+      const closed = records.length - open;
+      const assigned = new Set(records.map(record => record.owner).filter(Boolean)).size;
+      setText('nav-count', open);
+      setText('inbox-summary', openCount(open));
+      setText('filter-open', open);
+      setText('filter-resolved', closed);
+      setText('metric-open', open);
+      setText('metric-resolved', closed);
+      setText('routing-summary', records.length + ' demandes réparties entre ' + assigned + ' responsables.');
+    }
+
+    function overviewRow(record) {
+      return '<li><button type="button" class="overview-row" data-case="' + record.id + '">' +
+        avatar(record.name) + '<span><strong>' + plain(record.subject) + '</strong><small class="meta">' +
+        plain(record.name + ' · ' + record.organization) + '</small></span><span class="row-arrow">' + svg('up') + '</span></button></li>';
+    }
+
+    function renderOverview() {
+      const open = records.filter(record => !record.resolved);
+      const closed = records.filter(record => record.resolved);
+      get('open-requests').innerHTML = open.map(overviewRow).join('') || '<li class="empty">Aucune demande à traiter.</li>';
+      get('closed-requests').innerHTML = closed.map(overviewRow).join('') || '<li class="empty">Aucune demande résolue.</li>';
+      get('owners').innerHTML = [sophie, thomas].map(owner => {
+        const count = open.filter(record => record.owner === owner).length;
+        const percent = open.length ? 100 * count / open.length : 0;
+        return '<li class="owner-row">' + avatar(owner, true) +
+          '<div><span class="owner-name">' + plain(owner) + '</span><div class="owner-track" aria-hidden="true"><span class="owner-fill" style="width:' +
+          percent + '%"></span></div></div><span class="owner-count numeric" aria-label="' + openCount(count) + '">' + count + '</span></li>';
+      }).join('');
+    }
+
+    function queueRow(record) {
+      const selected = record.id === state.selected;
+      return '<li><button type="button" class="queue-row" data-case="' + record.id + '" aria-pressed="' + selected + '" aria-controls="folio">' +
+        avatar(record.name) + '<span><strong>' + plain(record.subject) + '</strong><small class="meta">' + plain(record.name + ' · ' + record.organization) +
+        '</small><small class="meta snippet">' + plain(record.preview) + '</small></span><span class="queue-arrow">' + svg('chevron') + '</span></button></li>';
+    }
+
+    function renderQueue() {
+      const visible = visibleRecords();
+      if (!visible.some(record => record.id === state.selected)) state.selected = visible[0]?.id ?? '';
+      get('queue-list').innerHTML = visible.map(queueRow).join('');
+      const empty = get('queue-empty');
+      empty.hidden = visible.length > 0;
+      empty.textContent = state.query.trim() ? 'Aucune demande ne correspond à cette recherche.' : 'Aucune demande dans cette file.';
+      announce(visible.length + (visible.length === 1 ? ' demande affichée.' : ' demandes affichées.'));
+      for (const button of filters) button.setAttribute('aria-pressed', String(button.dataset.filter === state.filter));
+      renderCase();
+    }
+
+    function renderThread(record) {
+      get('thread').innerHTML = record.thread.map(message => {
+        const staff = message.author !== record.name;
+        const marker = message.note ? '<span class="note-marker">' + svg('lock') + '</span>' : avatar(message.author, staff);
+        const label = message.note ? 'Note interne · ' + message.author : message.author;
+        const time = message.at ? '<span class="meta numeric">' + plain(message.at) + '</span>' : '';
+        return '<li class="message' + (message.note ? ' note' : '') + '">' + marker + '<div><div class="message-meta"><strong>' +
+          plain(label) + '</strong>' + time + '</div><p>' + plain(message.body) + '</p></div></li>';
+      }).join('');
+    }
+
+    function updateComposer(record) {
+      const note = state.mode === 'note';
+      const prompt = note ? 'Ajouter une note interne' : 'Écrire une réponse';
+      for (const button of modes) button.setAttribute('aria-pressed', String(button.dataset.mode === state.mode));
+      get('message').value = drafts.get(record.id + '/' + state.mode) ?? '';
+      get('message').placeholder = prompt + '…';
+      setText('message-label', prompt);
+      setText('composer-audience', note ? 'Visible par l’équipe uniquement' : 'Visible par le demandeur');
+      get('send-message').innerHTML = (note ? 'Ajouter' : 'Envoyer') + ' ' + svg(note ? 'lock' : 'send');
+    }
+
+    function renderCase() {
+      const record = records.find(item => item.id === state.selected);
+      get('reading').hidden = !record;
+      if (!record) return;
+      setText('case-title', record.subject);
+      setText('case-contact', record.name + ' · ' + record.organization);
+      setText('case-owner', record.owner ?? 'Non renseigné');
+      get('case-status').innerHTML = '<span class="dot" aria-hidden="true"></span>' + (record.resolved ? 'Résolue' : 'Ouverte');
+      get('case-action').innerHTML = svg(record.resolved ? 'inbox' : 'check') + (record.resolved ? 'Rouvrir' : 'Résoudre');
+      get('composer').hidden = Boolean(record.resolved);
+      renderThread(record);
+      get('thread').scrollTop = 0;
+      updateComposer(record);
+    }
+
+    function locationState() {
+      const tokens = location.hash.slice(1).toLowerCase().split('-');
+      return {
+        screen: tokens.includes('overview') ? 'overview' : 'inbox',
+        theme: tokens.includes('dark') ? 'dark' : tokens.includes('light') ? 'light' : preference.matches ? 'dark' : 'light'
+      };
+    }
+
+    function syncRoute({ focus = false, refresh = false } = {}) {
+      const next = locationState();
+      const screenChanged = state.screen !== next.screen;
+      Object.assign(state, next);
+      root.dataset.theme = state.theme;
+      get('inbox').hidden = state.screen !== 'inbox';
+      get('overview').hidden = state.screen !== 'overview';
+      document.title = names[state.screen] + ' · Fusengine';
+      for (const link of routes) {
+        link.hash = link.dataset.route + '-' + state.theme;
+        if (link.classList.contains('nav-link')) {
+          if (link.dataset.route === state.screen) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        }
+      }
+      const dark = state.theme === 'dark';
+      const action = dark ? 'Activer le thème clair' : 'Activer le thème sombre';
+      get('theme-toggle').title = action;
+      get('theme-toggle').setAttribute('aria-label', action);
+      get('theme-toggle').setAttribute('aria-pressed', String(dark));
+      setText('theme-name', dark ? 'Sombre' : 'Clair');
+      if (screenChanged || refresh) {
+        if (state.screen === 'overview') renderOverview();
+        else renderQueue();
+      }
+      if (screenChanged) window.scrollTo(0, 0);
+      if (focus) get(state.screen + '-title').focus({ preventScroll: true });
+    }
+
+    function navigate(screen, theme, options = {}) {
+      const hash = '#' + screen + '-' + theme;
+      if (location.hash !== hash) history.pushState(null, '', hash);
+      syncRoute(options);
+    }
+
+    function showCaseScroll() {
+      get('case-title').focus({ preventScroll: true });
+      get('reading').scrollIntoView({ block: 'start' });
+    }
+
+    function openCase(id, fromOverview = false) {
+      const record = records.find(item => item.id === id);
+      if (!record) return;
+      state.selected = record.id;
+      state.mode = 'reply';
+      if (fromOverview) {
+        state.query = '';
+        get('search').value = '';
+        state.filter = record.resolved ? 'resolved' : 'open';
+        navigate('inbox', state.theme, { focus: !mobile.matches, refresh: true });
+      } else {
+        renderQueue();
+        if (!mobile.matches) get('queue-list').querySelector('[aria-pressed="true"]')?.focus({ preventScroll: true });
+      }
+      if (mobile.matches) showCaseScroll();
+    }
+
+    function setNav(open, restore = true) {
+      shell.toggleAttribute('data-nav-open', open);
+      get('content').inert = open;
+      for (const trigger of document.querySelectorAll('.nav-toggle')) trigger.setAttribute('aria-expanded', String(open));
+      if (open) document.querySelector('.nav-close').focus();
+      else if (restore) navTrigger?.focus({ preventScroll: true });
+    }
+
+    document.addEventListener('click', event => {
+      const route = event.target.closest('[data-route]');
+      if (route && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey) {
+        event.preventDefault();
+        setNav(false, false);
+        if (route.dataset.openFilter) {
+          state.filter = route.dataset.openFilter;
+          state.query = '';
+          get('search').value = '';
+        }
+        navigate(route.dataset.route, state.theme, { focus: true, refresh: Boolean(route.dataset.openFilter) });
+        return;
+      }
+
+      const item = event.target.closest('[data-case]');
+      if (item) openCase(item.dataset.case, state.screen === 'overview');
+
+      const filter = event.target.closest('[data-filter]');
+      if (filter) {
+        state.filter = filter.dataset.filter;
+        renderQueue();
+      }
+
+      const mode = event.target.closest('[data-mode]');
+      if (mode) {
+        state.mode = mode.dataset.mode;
+        updateComposer(records.find(record => record.id === state.selected));
+      }
+
+      const trigger = event.target.closest('.nav-toggle');
+      if (trigger) {
+        navTrigger = trigger;
+        setNav(true);
+      }
+      if (event.target.closest('.nav-close, .nav-scrim')) setNav(false);
+    });
+
+    document.addEventListener('keydown', event => {
+      if (!shell.hasAttribute('data-nav-open')) return;
+      if (event.key === 'Escape') setNav(false);
+      if (event.key === 'Tab') {
+        const buttons = [...get('navigation').querySelectorAll('a,button')];
+        const last = buttons[buttons.length - 1];
+        if (event.shiftKey && document.activeElement === buttons[0]) { event.preventDefault(); last.focus(); }
+        if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); buttons[0].focus(); }
+      }
+    });
+    mobile.addEventListener('change', () => {
+      if (!mobile.matches && shell.hasAttribute('data-nav-open')) setNav(false, false);
+    });
+
+    get('theme-toggle').addEventListener('click', () => navigate(state.screen, state.theme === 'dark' ? 'light' : 'dark'));
+    get('search').addEventListener('input', event => {
+      state.query = event.target.value;
+      renderQueue();
+    });
+    get('back-queue').addEventListener('click', () => {
+      const selected = get('queue-list').querySelector('[aria-pressed="true"]');
+      (selected ?? get('queue-title')).focus({ preventScroll: true });
+      get('queue-title').scrollIntoView({ block: 'start' });
+    });
+    get('case-action').addEventListener('click', () => {
+      const record = records.find(item => item.id === state.selected);
+      record.resolved = !record.resolved;
+      state.filter = record.resolved ? 'resolved' : 'open';
+      renderCounts();
+      renderQueue();
+      get('case-title').focus({ preventScroll: true });
+      announce(record.resolved ? 'Demande résolue.' : 'Demande rouverte.');
+    });
+    get('message').addEventListener('input', event => {
+      drafts.set(state.selected + '/' + state.mode, event.target.value);
+    });
+    get('composer').addEventListener('submit', event => {
+      event.preventDefault();
+      const body = get('message').value.trim();
+      const record = records.find(item => item.id === state.selected);
+      if (!record || record.resolved || !body) return;
+      const note = state.mode === 'note';
+      record.thread.push({ author: sophie, body, note });
+      drafts.delete(state.selected + '/' + state.mode);
+      renderThread(record);
+      updateComposer(record);
+      get('thread').scrollTop = get('thread').scrollHeight;
+      get('message').focus({ preventScroll: true });
+      announce(note ? 'Note interne ajoutée à la maquette.' : 'Réponse ajoutée à la maquette.');
+    });
+
+    window.addEventListener('hashchange', () => syncRoute());
+    window.addEventListener('popstate', () => syncRoute());
+    preference.addEventListener('change', () => syncRoute());
+    renderCounts();
+    get('desk').hidden = false;
+    syncRoute();
+  </script>
+</body>
+</html>
*** End Patch
