const assert = require('node:assert/strict');
const { readFileSync } = require('node:fs');
const { createContext, Script } = require('node:vm');
const html = readFileSync('support-workbench-sol62.html', 'utf8');
const scripts = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)];
assert.equal(scripts.length, 2);
const compiled = scripts.map((script, index) => new Script(script[1], {filename: 'inline-script-' + (index + 1) + '.js'}));
const nodes = new Map();
const getNode = id => nodes.get(id) || (nodes.set(id, {value: '', dataset: {}, setAttribute() {}, removeAttribute() {}, focus() {}}), nodes.get(id));
const mkButtons = (key, values) => values.map(value => Object.assign(getNode(key + value), {dataset: {[key]: value}}));
const links = mkButtons('screen', ['inbox', 'overview']);
const filters = mkButtons('filter', ['open', 'resolved', 'all']);
const location = {hash: '', get href() { return 'file:///support-workbench-sol62.html' + this.hash; }};
const listeners = new Map();
const document = {
  documentElement: {dataset: {}},
  getElementById: getNode,
  addEventListener: (event, listener) => listeners.set(event, listener),
  querySelector: selector => selector === '.skip' ? {addEventListener() {}} : null,
  querySelectorAll: selector => selector === '[data-screen]' ? links : selector === '[data-filter]' ? filters : []
};
for (const node of [getNode('theme-toggle'), getNode('search'), getNode('clear-search'), getNode('lens-return')]) node.addEventListener = () => {};
const history = {state: null, replaceState(state) { this.state = state; }, pushState(state, _, url) { this.state = state; location.hash = url; }};
const context = createContext({document, location, history, matchMedia: () => ({matches: false}), ResizeObserver: class { observe() {} }, addEventListener: (event, listener) => listeners.set(event, listener)});
compiled.forEach(script => script.runInContext(context));
const run = source => new Script(source).runInContext(context);
const route = () => run('JSON.stringify(state)');
assert.equal(route(), '{"screen":"inbox","theme":"light","filter":"open"}');
assert.equal(getNode('open-total').textContent, 4);
assert.equal(getNode('resolved-total').textContent, 2);
for (const screen of ['inbox', 'overview']) for (const theme of ['light', 'dark']) {
  location.hash = '#' + screen + '-' + theme;
  listeners.get('hashchange')();
  assert.deepEqual(JSON.parse(route()), {screen, theme, filter: 'open'});
  assert.equal(document.documentElement.dataset.theme, theme);
  assert.equal(getNode('workload').hidden, screen === 'inbox');
  assert.equal(links[0].href, '#inbox-' + theme);
  assert.equal(links[1].href, '#overview-' + theme);
}
location.hash = '#inbox';
listeners.get('hashchange')();
assert.deepEqual(JSON.parse(route()), {screen: 'inbox', theme: 'dark', filter: 'open'});
location.hash = '#light';
listeners.get('hashchange')();
assert.deepEqual(JSON.parse(route()), {screen: 'inbox', theme: 'light', filter: 'open'});
run('switchRoute({screen: "overview"})');
assert.equal(location.hash, '#overview-light');
run('switchRoute({screen: "inbox", filter: "resolved"})');
assert.equal(location.hash, '#inbox-light');
assert.match(getNode('inbox-list').innerHTML, /data-request="widget"/);
assert.doesNotMatch(getNode('inbox-list').innerHTML, /data-request="access"/);
getNode('search').value = 'ABONNEMENT';
run('render()');
assert.match(getNode('inbox-list').innerHTML, /data-request="subscription"/);
assert.doesNotMatch(getNode('inbox-list').innerHTML, /data-request="widget"/);
getNode('search').value = '<img src=bad>';
run('render()');
assert.equal(getNode('inbox-list').innerHTML, '');
assert.equal(getNode('queue-empty').hidden, false);
assert.equal(getNode('lens-empty').hidden, false);
console.log('PASS: 2 inline classic-script syntax checks; VM smoke: four routes, two partial hashes, persisted theme/route links, 4/2 fixture totals, resolved filter, normalized search, empty states.');
