from math import *
def token(hex):
  rgbs=(int(hex[i:i+2],16)/255 for i in (0,2,4))
  r,g,b=(x/12.92 if x<=.04045 else ((x+.055)/1.055)**2.4 for x in rgbs)
  l=(.4122214708*r+.5363325363*g+.0514459929*b)**(1/3)
  m=(.2119034982*r+.6806995451*g+.1073969566*b)**(1/3)
  s=(.0883024619*r+.2817188376*g+.6299787005*b)**(1/3)
  L=.2104542553*l+.793617785*m-.0040720468*s
  a=1.9779984951*l-2.428592205*m+.4505937099*s
  b=.0259040371*l+.7827717662*m-.808675766*s
  return f'oklch({L:.5f} {hypot(a,b):.5f} {degrees(atan2(b,a))%360:.2f})'
for hex in 'eef1f6 151923 465c7c f8faff e6eafd 0000b6 0d0e14 13141c f1f4f8 8ea0ff 20263a 1b2030 becadd 222b4a 354157 566580 b7c2ff 7c899b'.split():
  print(hex,token(hex))
PY
