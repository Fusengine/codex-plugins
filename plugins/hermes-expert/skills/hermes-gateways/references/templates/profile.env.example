# profile.env.example - copy into the profile's .env (chmod 600), one file per profile.
# Write values with: hermes -p <profile> config set UPPER_SNAKE value   (goes to that profile's .env)
# A bot token belongs to ONE profile only (a duplicate is parked: duplicate_credential).
# Hermes Agent 0.23.0 - names verified in user-guide/messaging/{slack,telegram,discord,email}.md.

# --- Access (default = deny everyone not listed or paired) -------------------
GATEWAY_ALLOWED_USERS=<comma-separated ids, optional cross-platform list>
# GATEWAY_ALLOW_ALL_USERS=true          # never on a profile with terminal access

# --- Slack (Socket Mode) ------------------------------------------------------
SLACK_BOT_TOKEN=<xoxb-...>
SLACK_APP_TOKEN=<xapp-...>
SLACK_ALLOWED_USERS=<member ids, comma-separated>
SLACK_HOME_CHANNEL=<channel id for proactive output, e.g. ops channel>
SLACK_HOME_CHANNEL_NAME=<readable name>
# SLACK_ALLOWED_CHANNELS=<channel ids>

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<bot token>
TELEGRAM_ALLOWED_USERS=<user ids>
TELEGRAM_HOME_CHANNEL=<chat id>

# --- Discord ------------------------------------------------------------------
DISCORD_BOT_TOKEN=<bot token>
DISCORD_ALLOWED_USERS=<user ids>
DISCORD_HOME_CHANNEL=<channel id>
# DISCORD_REQUIRE_MENTION=false

# --- Email adapter (ONE mailbox per profile; dedicated agent address only) ---
# EMAIL_ADDRESS=<agent-address@example.com>
# EMAIL_PASSWORD=<app password>
# EMAIL_IMAP_HOST=<imap.example.com>
# EMAIL_SMTP_HOST=<smtp.example.com>
# EMAIL_AUTHSERV_ID=<authserv-id of your receiving server>
# EMAIL_ALLOWED_USERS=<allowed sender addresses>
# EMAIL_HOME_ADDRESS=<owner address for cron delivery>

# --- Voice providers (only the ones you use) ----------------------------------
# ELEVENLABS_API_KEY=<key>
# VOICE_TOOLS_OPENAI_KEY=<key>
# GROQ_API_KEY=<key>
